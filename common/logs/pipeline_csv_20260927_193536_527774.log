#!/bin/bash

name_dir=$1

find="_tmp.nii.gz"
replace="_smth_brain.nii.gz"

for names in ${name_dir}/*levelset_tmp.nii.gz
do
    name_in=$names
    ###name_out=echo $names | sed -e "s/'_tmp.nii.gz'/'_smth_brain.nii.gz'/g"         
    name_out=${name_in//$find/$replace}

    echo "/usr/lib/fsl/5.0/bet $name_in $name_out -f 0.01"
    /usr/lib/fsl/5.0/bet $name_in $name_out -f 0.01
    #echo $name_in
    #echo $name_out
done;
